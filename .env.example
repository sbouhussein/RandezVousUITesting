FIREBASE_SERVICE_ACCOUNT_KEY_PATH=private/service-account-key.json

# Appium server
APPIUM_PORT=4723

# iOS device / simulator — see README for how to find these values
DEVICE_NAME=iPhone 17 Pro
PLATFORM_VERSION=26.2
UDID=02702BB3-0AE0-4167-9651-39F68787A375

# App bundle IDs
RV_BUNDLE_ID=sbouhussein.github.io-rvsite.RandezVous
SAFARI_BUNDLE_ID=com.apple.mobilesafari

# Android emulator/device (Android Studio > Device Manager > your AVD's name) --
# only needed for tests using android_chrome_driver.
ANDROID_DEVICE_NAME=Pixel_8_API_34
ANDROID_PLATFORM_VERSION=14
# Only needed if more than one adb device/emulator is running at once.
# ANDROID_UDID=emulator-5554

# RV's Trusted Web Activity package, already live on Google Play -- verified in
# rvsite/public/.well-known/assetlinks.json. Tests that need it installed on the
# emulator/device skip cleanly with an explanatory message if it isn't.
RV_ANDROID_PACKAGE=com.randezvous.RandezVous

# Firebase Console > App Check > (RandezVous app) > Manage debug tokens.
FIREBASE_APP_CHECK_DEBUG_TOKEN=GENERATE-IN-CONSOLE-AND-ADD-HERE

# Where is your web app located
WEB_APP_PATH="../../RandezVousSite/rvsite"
